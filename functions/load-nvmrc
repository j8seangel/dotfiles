#!/bin/zsh
#
# Automatically call nvm use when entering a directory with a .nvmrc file
# Based on: https://github.com/nvm-sh/nvm#calling-nvm-use-automatically-in-a-directory-with-a-nvmrc-file

load-nvmrc() {
  # Only proceed if nvm is available
  command -v nvm >/dev/null 2>&1 || return

  local node_version="$(nvm version)"
  local nvmrc_path="$(nvm_find_nvmrc)"

  if [ -n "$nvmrc_path" ]; then
    local nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

    if [ "$nvmrc_node_version" = "N/A" ]; then
      nvm install
    elif [ "$nvmrc_node_version" != "$node_version" ]; then
      nvm use
    fi
  elif [ "$node_version" != "$(nvm version default)" ]; then
    echo "Reverting to nvm default version"
    nvm use default
  fi
}

# Set up hook when this file is sourced (after nvm is loaded)
if command -v nvm >/dev/null 2>&1; then
  autoload -U add-zsh-hook
  add-zsh-hook chpwd load-nvmrc
  # Run load-nvmrc on initialization
  load-nvmrc
fi

