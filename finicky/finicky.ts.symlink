import type {
  BrowserHandler,
  FinickyConfig,
  UrlRewriteRule,
} from '/Applications/Finicky.app/Contents/Resources/finicky.d.ts';

const gfwHandler: BrowserHandler = {
  match: (url: URL, { opener }) => {
    return [
      'meet.google.com',
      'globalfishingwatch.org',
      'globalfishingwatch.atlassian.net',
      'zoom.us',
      'github.com',
      'notion.so',
      'loom.com',
      'slack.com',
      'docs.google.com',
      'drive.google.com',
      'calendar.google.com',
      'meet.google.com',
      'globalfishingwatch.org',
      'globalfishingwatch.atlassian.net',
    ].some((host) => url.host.includes(host));
  },
  browser: 'Google Chrome',
};

const devHandler: BrowserHandler = {
  match: /localhost:[0-9]{1,4}/,
  browser: 'Google Chrome',
};

const spotifyHandler: BrowserHandler = {
  match: 'open.spotify.com*',
  browser: 'Spotify',
};

const trackingRewrite: UrlRewriteRule = {
  // Remove all marketing/tracking information from urls
  match: finicky.matchHostnames([/amazon\.(es|com)/]),
  url(url) {
    const removeKeysStartingWith = ['utm_', 'uta_']; // Remove all query parameters beginning with these strings
    const removeKeys = ['fblid', 'gclid']; // Remove all query parameters matching these keys

    const search = url.search
      .split('&')
      .map((parameter) => parameter.split('='))
      .filter(
        ([key]) =>
          !removeKeysStartingWith.some((startingWith) =>
            key.startsWith(startingWith)
          )
      )
      .filter(([key]) => !removeKeys.some((removeKey) => key === removeKey));

    return {
      ...url,
      search: search.map((parameter) => parameter.join('=')).join('&'),
    };
  },
};

const config: FinickyConfig = {
  defaultBrowser: 'Safari',
  options: {
    // hideIcon: false,
    checkForUpdates: false,
  },
  handlers: [gfwHandler, devHandler, spotifyHandler],
  rewrite: [trackingRewrite],
};

export default config;
